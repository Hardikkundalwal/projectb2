{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "module",
    "skills",
    "duration_minutes",
    "forms",
    "pass_threshold",
    "repair_on_fail",
    "original_content_only"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "exercise_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "exercise_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "pass_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "repair_on_fail": {
      "type": "boolean"
    },
    "original_content_only": {
      "const": true
    }
  }
}
