{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exercise",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "node_id",
    "type",
    "prompt",
    "skill_tags",
    "scoring",
    "explanation",
    "provenance",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "multiple_choice",
        "matching",
        "cloze",
        "ordering",
        "error_correction",
        "short_response",
        "writing",
        "speaking"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "stimulus": {
      "type": [
        "string",
        "null"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skill_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "exact",
            "set",
            "regex",
            "rubric"
          ]
        },
        "answer": {},
        "max_points": {
          "type": "number",
          "minimum": 0
        },
        "rubric_id": {
          "type": "string"
        }
      }
    },
    "explanation": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "foundation",
        "standard",
        "transfer",
        "checkpoint"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "original",
        "author"
      ],
      "properties": {
        "original": {
          "const": true
        },
        "author": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "released"
      ]
    }
  }
}
